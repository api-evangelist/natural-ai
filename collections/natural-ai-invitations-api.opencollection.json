{
  "opencollection": "1.0.0",
  "info": {
    "name": "Natural Agent Keys Invitations API",
    "version": "0.2.0"
  },
  "items": [
    {
      "info": {
        "name": "Invitations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List party invitations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.natural.com/party-invitations",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "partyId",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List party invitations"
        },
        {
          "info": {
            "name": "Create party invitations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.natural.com/party-invitations",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Invite people to join the party. Available for business parties."
        },
        {
          "info": {
            "name": "Revoke party invitation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.natural.com/party-invitations/:invitationId",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "invitationId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revoke a pending party invitation"
        }
      ]
    }
  ],
  "bundled": true
}