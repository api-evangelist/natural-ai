{
  "opencollection": "1.0.0",
  "info": {
    "name": "Natural Agent Keys API",
    "version": "0.2.0"
  },
  "items": [
    {
      "info": {
        "name": "Agent Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agent keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.natural.com/agent-keys",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List agent keys"
        },
        {
          "info": {
            "name": "Create agent key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.natural.com/agent-keys",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create an agent key for an agent. The secret is returned only once."
        },
        {
          "info": {
            "name": "Revoke agent key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.natural.com/agent-keys/:keyId",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revoke an agent key immediately without issuing a replacement. Other active keys for the same agent keep working."
        },
        {
          "info": {
            "name": "Rotate agent key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.natural.com/agent-keys/:keyId/rotate",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate a replacement agent key."
        }
      ]
    }
  ],
  "bundled": true
}