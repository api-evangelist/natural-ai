{
  "opencollection": "1.0.0",
  "info": {
    "name": "Natural Agent Keys API Keys API",
    "version": "0.2.0"
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.natural.com/api-keys",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List API keys"
        },
        {
          "info": {
            "name": "Create API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.natural.com/api-keys",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create an API key. The secret is returned only once."
        },
        {
          "info": {
            "name": "Get API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.natural.com/api-keys/:keyId",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get an API key"
        },
        {
          "info": {
            "name": "Revoke API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.natural.com/api-keys/:keyId",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revoke an API key"
        }
      ]
    }
  ],
  "bundled": true
}