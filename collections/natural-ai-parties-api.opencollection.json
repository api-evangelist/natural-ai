        {
          "info": {
            "name": "Disable party approval limits",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.natural.com/parties/me/limits",
            "headers": [
              {
                "name": "X-Agent-ID",
