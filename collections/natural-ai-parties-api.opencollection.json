                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the current party"
        },
        {
          "info": {
            "name": "Update party",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.natural.com/parties/me",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update the current party"
        },
        {
          "info": {
            "name": "List party members",
            "type": "http"
