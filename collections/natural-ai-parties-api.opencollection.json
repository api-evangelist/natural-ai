          "http": {
            "method": "PUT",
            "url": "https://api.natural.com/parties/me/limits",
            "headers": [
              {
                "name": "X-Agent-ID",
                "value": ""
              },
              {
                "name": "X-Instance-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
